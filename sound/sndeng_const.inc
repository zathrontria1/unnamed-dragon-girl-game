SEQ_OPCODE_NOTE_CUT     = $9b
SEQ_OPCODE_CALL_SUB     = $9c
SEQ_OPCODE_RET          = $9d
SEQ_OPCODE_RESTART      = $ff

; Define the stream data as this particular sample
STR_STREAM_DATA = $3f

